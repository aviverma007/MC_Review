# ---- MC Review backend configuration ----------------------------------------
# Copy to .env next to server.js and fill in. Values shown are the production
# defaults for server 2023-DT1.

PORT=5094

# Long random string; all issued JWTs die if this changes.
JWT_SECRET=change-me-to-a-long-random-string

# SQL Server (dedicated DB + login; do NOT reuse SmartDeskApp)
DB_SERVER=2023-DT1
DB_PORT=1433
DB_DATABASE=MCReviewDB
DB_USER=mcreview_user
DB_PASSWORD=
DB_POOL_MAX=20
DB_REQUEST_TIMEOUT_MS=60000

# Where published MC-Review PDFs are written on the server.
# Default if unset: <backend>/published-pdfs
PDF_DIR=D:\smartdesk_live\MC_Review\published-pdfs

# Unicode font for the ₹ symbol in PDFs (auto-detected on Windows; override
# only if Arial is missing).
# PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf

# ---- QMS feed mirror --------------------------------------------------------
# First date of the one-time full history sync (runs in background on first
# boot, resumable). Earliest data in the feed is ~2022.
QMS_HISTORY_START=2022-01-01
# Minutes between rolling refreshes of recent data.
QMS_SYNC_INTERVAL_MIN=10
# Days each rolling refresh covers (catches late NFA creation on old PRs).
QMS_SYNC_LOOKBACK_DAYS=45
# QMS_FEED_URL=https://smartworlddevelopersonline.com/SapPrNFATatReport.php
# QMS_SYNC_DISABLED=1        # only on a second read-only instance

# ---- misc -------------------------------------------------------------------
# Log any request slower than this many ms (find freezes fast).
SLOW_MS=2000
# Set to 0 to stop serving frontend/dist from this process.
# SERVE_FRONTEND=1
